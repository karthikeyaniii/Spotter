# Optional settings; everything works without them. The app reads real environment
# variables (it does not load .env files itself): export them in your shell, or use
# `docker run --env-file .env`. Leave a value empty to keep the default.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
MAX_DETOUR_MILES=10
STOP_PENALTY_USD=10
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io
GEOCODER_USER_AGENT=spotter-fuel-route-planner/1.0
GEOCODER_TIMEOUT_SECONDS=6
THROTTLE_ROUTE=30/minute
THROTTLE_PLACES=240/minute
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CACHE_DIR=
DJANGO_HSTS_PRELOAD=0
LOG_LEVEL=INFO
