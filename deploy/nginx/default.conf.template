# Load balancer in front of the web replicas. ${NGINX_API_RATE} comes from the environment.
resolver 127.0.0.11 valid=10s ipv6=off;  # Docker DNS: picks up replicas added by --scale

upstream app {
    zone app 64k;
    server web:8000 resolve;  # every replica's IP
    # Send each request to the replica with the fewest in-flight requests. No upstream
    # keep-alive: gunicorn sync workers take one connection at a time, which lets the
    # kernel hand requests only to idle workers.
    least_conn;
}

limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=${NGINX_API_RATE};

log_format lb '$remote_addr "$request" $status $body_bytes_sent '
              'rt=$request_time urt=$upstream_response_time up=$upstream_addr rid=$request_id';

server {
    listen 80;
    server_tokens off;
    access_log /dev/stdout lb;
    client_max_body_size 64k;

    gzip on;
    gzip_comp_level 4;  # good ratio for JSON at low CPU cost
    gzip_proxied any;
    gzip_vary on;
    gzip_types application/json application/geo+json text/css application/javascript image/svg+xml;
    gzip_min_length 1024;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    add_header X-Request-ID $request_id always;
    proxy_connect_timeout 3s;
    proxy_read_timeout 75s;
    # A replica that is down or restarting: retry the (idempotent) request on another one.
    proxy_next_upstream error timeout http_502 http_503;
    proxy_next_upstream_tries 3;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location /api/ {
        limit_req zone=api_per_ip burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://app;
    }

    location / {
        proxy_pass http://app;
    }
}
