# Copy to .env next to docker-compose.yml (docker compose reads it automatically).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
HTTP_PORT=8080
WEB_REPLICAS=3
WEB_CONCURRENCY=4
THROTTLE_ROUTE=30/minute
THROTTLE_PLACES=240/minute
NGINX_API_RATE=20r/s
